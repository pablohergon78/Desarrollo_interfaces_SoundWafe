<Window x:Class="prueba.agregarcancionesextra"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Añadir canciones"
        Height="520"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#181818"
        Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Seleccionar canciones"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,14"/>

        <ListBox Grid.Row="1"
                 x:Name="lstCanciones"
                 Background="#141414"
                 Foreground="White"
                 BorderBrush="#2A2A2A"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,7"
                            BorderBrush="#242424"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding EstaSeleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"/>

                            <!-- Sin título de canción -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Titulo}"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Album}"
                                           Foreground="#9BA3B0"
                                           FontSize="12"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Duracion}"
                                       Foreground="#9BA3B0"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancelar"
                    Width="90"
                    Height="34"
                    Margin="0,0,10,0"
                    Click="BtnCancelar_Click"/>
            <Button Content="Guardar"
                    Width="95"
                    Height="34"
                    Background="#27D92D"
                    Foreground="#121212"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>