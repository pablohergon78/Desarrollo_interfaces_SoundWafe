<Window x:Class="prueba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prueba"
        mc:Ignorable="d"
        Title="SoundWafe" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#090B0E">

    <Window.Resources>
        <!-- Estilo unificado y corregido para los botones del menú -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A8B4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <!-- IMPORTANTE: TextElement.Foreground permite que el texto herede el color del botón correctamente -->
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Efecto Hover: Cambia el fondo a un gris oscuro elegante y el texto a verde clarito -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1F26"/>
                                <Setter Property="Foreground" Value="#32F238"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 1. MENÚ LATERAL IZQUIERDO ================= -->
        <Border Grid.Column="0" Background="#000000" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,35">
                    <Image Source="Assets/LogoBosco2.png"
                        Width="32"
                        Height="32"
                        Stretch="Uniform"
                         VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="SoundWafe" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Botones de navegación (Los cuatro idénticos) -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="BtnInicio" Content="🏠   Inicio" Click="MenuInicio_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnArtistas" Content="💿   Artistas y álbumes" Click="MenuArtistas_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnCanciones" Content="🎵   Canciones" Click="MenuCanciones_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnListas" Content="📂   Mis listas" Click="MenuListas_Click" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>

                <!-- Perfil -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Border Width="38" Height="38" CornerRadius="19" Background="#27D92D" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtInicialesUsuario" Text="U" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtUsuario" Text="Usuario" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Sesión Firebase" Foreground="#7A8494" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. CONTENIDO Y BARRA SUPERIOR ================= -->
        <Grid Grid.Column="1" Background="#0D0F12">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra superior derecha -->
            <Border Grid.Row="0" Background="#090B0E" Padding="25,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="🔔" Foreground="#A0A8B4" FontSize="14" Margin="0,0,20,0" Cursor="Hand"/>
                    <TextBlock Text="⚙️ Ajustes" Foreground="#A0A8B4" FontSize="13" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- TabControl oculto -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderBrush="Transparent" SelectionChanged="MainTabControl_SelectionChanged_1">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- Pestaña 1: Inicio -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40">

                            <StackPanel.Resources>
                                <!-- Estilo de las tarjetas de éxitos: se iluminan con el borde verde al pasar el ratón -->
                                <Style x:Key="TarjetaExito" TargetType="Border">
                                    <Setter Property="Background" Value="#161A22"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Padding" Value="15"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1D2330"/>
                                            <Setter Property="BorderBrush" Value="#27D92D"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Resources>

                            <Border Background="#161A22" CornerRadius="12" Padding="35" Height="220" Margin="0,0,0,30">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Width="450" HorizontalAlignment="Left">
                                        <TextBlock Text="NUSTROS MEJORES TEMAS" Foreground="#27D92D" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Entre Salesianos" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBlock Text="Con Vali y los Valipaldis y mucho más" Foreground="#A0A8B4" FontSize="14" Margin="0,0,0,15"/>
                                        <Button Content="Ver canciones →" Width="130" Height="32" Background="#27D92D" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="VerCanciones_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ÉXITOS -->
                            <TextBlock Text="Éxitos" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                            <UniformGrid Columns="2" Margin="0,0,0,30">

                                <!-- Éxito 1 -->
                                <Border Style="{StaticResource TarjetaExito}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="23" Background="#27D92D">
                                            <TextBlock Text="♪" FontSize="22" FontWeight="Bold" Foreground="#0F1218"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Vali de extraradio" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Vali y los Valipaldis" Foreground="#A0A8B4" FontSize="13" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Éxito 2 -->
                                <Border Style="{StaticResource TarjetaExito}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="23" Background="#27D92D">
                                            <TextBlock Text="♪" FontSize="22" FontWeight="Bold" Foreground="#0F1218"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Lo que me pasaste" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Amores Yatra" Foreground="#A0A8B4" FontSize="13" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>

                            <TextBlock Text="Mis Listas" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                            <UniformGrid Columns="3" Height="100">
                                <Border Background="#161A22" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                                    <TextBlock Text="Modo foco" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#161A22" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                                    <TextBlock Text="Sube el ritmo" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#161A22" CornerRadius="8" Padding="15">
                                    <TextBlock Text="En carretera" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Pestaña 2: Artistas y Álbumnes -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32">
                        <StackPanel>

                            <!-- Cabecera editorial -->
                            <TextBlock Text="EXPLORA EL CATÁLOGO"
                       Foreground="#7A8494"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

                            <TextBlock Text="Artistas y álbumes"
                       FontFamily="Georgia"
                       FontSize="40"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       Margin="0,0,0,6"/>

                            <TextBlock Text="Voces, historias y discos para descubrir con calma."
                       Foreground="#A0A8B4"
                       FontSize="13"
                       Margin="0,0,0,34"/>

                            <!-- SECCIÓN ARTISTAS -->
                            <TextBlock Text="VOCES DESTACADAS"
                       Foreground="#7A8494"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,0,0,4"/>

                            <TextBlock Text="Artistas"
                       FontFamily="Georgia"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       Margin="0,0,0,16"/>

                            <!-- Artistas (se rellena desde Firebase: catalogo/artistas) -->
                            <ItemsControl x:Name="lstArtistas" Margin="0,0,-16,38">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,16,0">
                                            <Grid Height="250" Background="#161A22" ClipToBounds="True" Margin="0,0,0,10">
                                                <Image Source="pack://application:,,,/Assets/cantante.png" Stretch="UniformToFill"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Nombre}" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Genero}" Foreground="#7A8494" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- SECCIÓN ÁLBUMES -->
                            <TextBlock Text="DISCOS ESENCIALES"
                       Foreground="#7A8494"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,0,0,4"/>

                            <TextBlock Text="Álbumes"
                       FontFamily="Georgia"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       Margin="0,0,0,16"/>

                            <!-- Álbumes (se rellena desde Firebase: catalogo/albumes) -->
                            <ItemsControl x:Name="lstAlbumes" Margin="0,0,-16,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,16,0">
                                            <Grid Height="200" Background="#161A22" ClipToBounds="True" Margin="0,0,0,10">
                                                <Image Source="pack://application:,,,/Assets/cantante.png" Stretch="UniformToFill"/>
                                                <TextBlock Text="{Binding Titulo}"
                                           FontFamily="Georgia"
                                           FontStyle="Italic"
                                           Foreground="#FFFFFF"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="8,0,8,12"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Titulo}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitulo}" Foreground="#7A8494" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Pestaña 3: Canciones -->
                <!-- Pestaña 3: Canciones -->
                <TabItem Header="Canciones">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32" Background="#121212">
                        <StackPanel>

                            <!-- Cabecera editorial -->
                            <TextBlock Text="TODO EL CATÁLOGO"
                       Foreground="#27D92D"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

                            <TextBlock Text="Canciones"
                       FontFamily="Georgia"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       Margin="0,0,0,6"/>

                            <!-- Contador dinámico -->
                            <TextBlock x:Name="TxtContadorCanciones"
                       Text="0 canciones esperando su próxima lista."
                       Foreground="#8E96A4"
                       FontSize="13"
                       Margin="0,0,0,22"/>

                            <!-- Cabecera de columnas de la tabla -->
                            <Grid Margin="12,0,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="TÍTULO" Foreground="#6E7685" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="ÁLBUM" Foreground="#6E7685" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="🕒" Foreground="#6E7685" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Height="1" Background="#1C2028" Margin="0,0,0,4"/>

                            <!-- Lista de todas las canciones -->
                            <ItemsControl x:Name="ListaCancionesControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="12,10" BorderBrush="#161A21" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Título + Cantante -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Titulo}"
                                               Foreground="#F3F4F6"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Cantante}"
                                               Foreground="#7E8796"
                                               FontSize="11.5"
                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Álbum -->
                                                <TextBlock Grid.Column="1"
                                           Text="{Binding Album}"
                                           Foreground="#9BA3B0"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"/>

                                                <!-- Duración -->
                                                <TextBlock Grid.Column="2"
                                           Text="{Binding Duracion}"
                                           Foreground="#7E8796"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>

                                                <!-- Botón circular '+' con evento Click -->
                                                <Button Grid.Column="3"
                                        Content="+"
                                        Click="AgregarCancionLista_Click"
                                        Width="26"
                                        Height="26"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Foreground="#9BA3B0"
                                        BorderBrush="#2A2F38"
                                        BorderThickness="1"
                                        FontSize="13"
                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="13">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Pestaña 4: Mis Listas -->
                <TabItem Header="Mis Listas">
                    <Grid Margin="30" Background="#121212">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                   Text="Sección de Mis Listas"
                   Foreground="#27D92D"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

                        <!-- Vista principal: botón "+" y ListBox de listas -->
                        <Grid Grid.Row="1" x:Name="gridListasPrincipal" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                    x:Name="btnAnadirLista"
                    Content="+"
                    Width="100"
                    Height="100"
                    FontSize="64"
                    FontWeight="Bold"
                    Foreground="#121212"
                    Background="#27D92D"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="BtnAnadirLista_Click"/>

                            <ListBox Grid.Column="1"
                     x:Name="lstPlaylists"
                     Margin="20,0,0,0"
                     Background="#141414"
                     Foreground="#FFFFFF"
                     BorderBrush="#2A2A2A"
                     FontSize="28"
                      SelectionChanged="lstPlaylists_SelectionChanged">
                                 <ListBox.ItemTemplate>
                                     <DataTemplate>
                                         <TextBlock Text="{Binding Nombre}"
                                                    Foreground="#FFFFFF"
                                                    Padding="12,8"/>
                                     </DataTemplate>
                                 </ListBox.ItemTemplate>
                             </ListBox>
                        </Grid>

                        <!-- StackPanel de detalle al pulsar una lista -->
                        <StackPanel Grid.Row="1"
                    x:Name="spDetalleLista"
                    Orientation="Vertical"
                    Background="#121212"
                    Visibility="Collapsed">

                            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Left"
                        x:Name="btnVolverListas"
                        Content="← Volver"
                        Padding="12,6"
                        Margin="0,0,10,0"
                        Background="#222222"
                        Foreground="#FFFFFF"
                        BorderBrush="#3A3A3A"
                        Cursor="Hand"
                        Click="BtnVolverListas_Click"/>

                                <Button DockPanel.Dock="Left"
                        x:Name="btnAgregarCanciones"
                        Content="+ Canciones"
                        Padding="12,6"
                        Margin="0,0,14,0"
                        Background="#27D92D"
                        Foreground="#121212"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="btnAgregarCanciones_Click"/>

                                <TextBlock DockPanel.Dock="Right"
                           x:Name="txtDuracionTotal"
                           Text="Duración total: 00:00"
                           Foreground="#9BA3B0"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

                                <!-- Título de la lista actual con contraste claro sobre fondo oscuro -->
                                <TextBlock x:Name="txtTituloListaActual"
                           Text=""
                           Foreground="#27D92D"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,10">
                                <TextBlock Text="Ordenar: "
                           Foreground="#9BA3B0"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                                <ComboBox x:Name="cmbOrdenCanciones"
                          Width="140"
                          Foreground="#121212"
                          Background="#FFFFFF"
                          SelectedIndex="0"
                          SelectionChanged="CmbOrdenCanciones_SelectionChanged">
                                    <ComboBoxItem Content="Nombre" Foreground="#121212" Background="#FFFFFF"/>
                                    <ComboBoxItem Content="Duración" Foreground="#121212" Background="#FFFFFF"/>
                                </ComboBox>
                            </StackPanel>

                            <DataGrid x:Name="dgCancionesPlaylist"
                      Height="360"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="#141414"
                      Foreground="#FFFFFF"
                      RowBackground="#181818"
                      AlternatingRowBackground="#1E1E1E"
                      BorderBrush="#2A2A2A"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2A2A2A">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#202020"/>
                                        <Setter Property="Foreground" Value="#27D92D"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="BorderBrush" Value="#2A2A2A"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Numero}" Width="45"/>
                                    <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                                    <DataGridTextColumn Header="Cantante" Binding="{Binding Cantante}" Width="*"/>
                                    <DataGridTextColumn Header="Álbum" Binding="{Binding Album}" Width="*"/>
                                    <DataGridTextColumn Header="Duración" Binding="{Binding Duracion}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>