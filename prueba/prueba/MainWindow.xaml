<Window x:Class="prueba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prueba"
        mc:Ignorable="d"
        Title="SoundWafe" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#090B0E">

    <Window.Resources>
        <!-- Estilo unificado y corregido para los botones del menú -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A8B4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <!-- IMPORTANTE: TextElement.Foreground permite que el texto herede el color del botón correctamente -->
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Efecto Hover: Cambia el fondo a un gris oscuro elegante y el texto a verde clarito -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1F26"/>
                                <Setter Property="Foreground" Value="#32F238"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 1. MENÚ LATERAL IZQUIERDO ================= -->
        <Border Grid.Column="0" Background="#000000" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,35">
                    <TextBlock Text="🎵" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="SoundWafe" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Botones de navegación (Los cuatro idénticos) -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="BtnInicio" Content="🏠   Inicio" Click="MenuInicio_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnArtistas" Content="💿   Artistas y álbumes" Click="MenuArtistas_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnCanciones" Content="🎵   Canciones" Click="MenuCanciones_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnListas" Content="📂   Mis listas" Click="MenuListas_Click" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>

                <!-- Perfil -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Border Width="38" Height="38" CornerRadius="19" Background="#27D92D" Margin="0,0,12,0">
                        <TextBlock Text="IM" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Isabel Martínez" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Tu biblioteca" Foreground="#7A8494" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. CONTENIDO Y BARRA SUPERIOR ================= -->
        <Grid Grid.Column="1" Background="#0D0F12">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra superior derecha -->
            <Border Grid.Row="0" Background="#090B0E" Padding="25,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="🔔" Foreground="#A0A8B4" FontSize="14" Margin="0,0,20,0" Cursor="Hand"/>
                    <TextBlock Text="⚙️ Ajustes" Foreground="#A0A8B4" FontSize="13" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- TabControl oculto -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderBrush="Transparent">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- Pestaña 1: Inicio -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40">
                            <Border Background="#161A22" CornerRadius="12" Padding="35" Height="220" Margin="0,0,0,30">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Width="450" HorizontalAlignment="Left">
                                        <TextBlock Text="NUEVO · INDIE POP" Foreground="#27D92D" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Entre líneas" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBlock Text="Mara Vélez" Foreground="#A0A8B4" FontSize="14" Margin="0,0,0,15"/>
                                        <Button Content="Ver canciones →" Width="130" Height="32" Background="#27D92D" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Mis Listas" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                            <UniformGrid Columns="3" Height="100">
                                <Border Background="#161A22" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                                    <TextBlock Text="Modo foco" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#161A22" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                                    <TextBlock Text="Sube el ritmo" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#161A22" CornerRadius="8" Padding="15">
                                    <TextBlock Text="En carretera" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Pestaña 2: Artistas y Álbumnes -->
                <TabItem>
                    <Grid Margin="40">
                        <TextBlock Text="Sección de Artistas y Álbumnes" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </Grid>
                </TabItem>

                <!-- Pestaña 3: Canciones -->
                <TabItem>
                    <Grid Margin="40">
                        <TextBlock Text="Sección de Canciones" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </Grid>
                </TabItem>

                <!-- Pestaña 4: Mis Listas -->
                <TabItem>
                    <Grid Margin="40">
                        <TextBlock Text="Sección de Mis Listas" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>