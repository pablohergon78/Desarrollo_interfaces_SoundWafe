<Window x:Class="prueba.login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prueba"
        mc:Ignorable="d"
        Title="login"
        Height="650" Width="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#121212"
        FontFamily="Segoe UI">

    <!-- Contenedor principal. -->
    <Grid Background="#121212" Margin="40">

        <!-- Formulario centrado. -->
        <Border Background="#181818"
                BorderBrush="#242424"
                BorderThickness="1"
                CornerRadius="12"
                Width="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="48,44">

            <!-- Ajusta el tamaño del formulario. -->
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1.25" ScaleY="1.25" CenterX="280" CenterY="180"/>
            </Border.RenderTransform>

            <!-- Coloca los controles uno debajo de otro. -->
            <StackPanel>

                <!-- Título principal -->
                <TextBlock Text="Iniciar sesión"
                           Foreground="#FFFFFF"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Campo de correo. -->
                <TextBox x:Name="txtEmail"
                         Height="44"
                         FontSize="15"
                         Margin="0,0,0,14"
                         Background="#222222"
                         Foreground="#FFFFFF"
                         BorderBrush="#333333"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         Padding="14,0"/>

                <!-- Campo de contraseña. -->
                <PasswordBox x:Name="txtPassword"
                             Height="44"
                             FontSize="15"
                             Margin="0,0,0,22"
                             Background="#222222"
                             Foreground="#FFFFFF"
                             BorderBrush="#333333"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             Padding="14,0"/>

                <!-- Botón de acceso. -->
                <Button x:Name="btnEntrar"
                        Content="Entrar"
                        Height="46"
                        FontSize="15"
                        Background="#27D92D"
                        Foreground="#121212"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="btnEntrar_Click"/>

                <!-- Mensaje de estado. -->
                <TextBlock x:Name="lblMensaje"
                           Text=""
                           FontSize="13"
                           Margin="0,14,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#9BA3B0"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>