<Window x:Class="prueba.login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prueba"
        mc:Ignorable="d"
        Title="Login - SoundWafe" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Grid>
        <!-- contenedor centrado -->
        <StackPanel Width="280" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Título  -->
            <TextBlock Text="SOUNDWAFE" Foreground="#27D92D" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <!-- Usuario -->
            <TextBlock Text="Usuario" Foreground="DarkGray" FontSize="12" Margin="0,0,0,5"/>
            <TextBox Height="35" Margin="0,0,0,15" Background="#1E1E1E" Foreground="White" BorderBrush="#333"/>

            <!-- Contraseña -->
            <TextBlock Text="Contraseña" Foreground="DarkGray" FontSize="12" Margin="0,0,0,5"/>
            <PasswordBox Height="35" Margin="0,0,0,25" Background="#1E1E1E" Foreground="White" BorderBrush="#333"/>

            <!-- Botón de entrar -->
            <Button Content="Entrar" Height="40" Background="#27D92D" Foreground="Black" 
                    FontWeight="Bold" Cursor="Hand" Click="Entrar_Click"/>

        </StackPanel>
    </Grid>
</Window>